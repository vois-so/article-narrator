{
  "name": "@vois-so/article-narrator",
  "version": "0.1.0",
  "description": "Listen to this article: a build step that speaks new and changed posts with Vois Studio, and a small accessible audio player.",
  "type": "module",
  "bin": {
    "article-narrator": "article-narrator.mjs"
  },
  "exports": {
    ".": "./src/build.mjs",
    "./player": {
      "types": "./player/article-narrator.d.ts",
      "default": "./player/article-narrator.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "article-narrator.mjs",
    "src/",
    "player/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/spoken.test.mjs test/markdown.test.mjs test/build.test.mjs test/player.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vois-so/article-narrator.git"
  },
  "homepage": "https://github.com/vois-so/article-narrator",
  "license": "MIT",
  "keywords": [
    "text-to-speech",
    "tts",
    "blog",
    "audio",
    "accessibility",
    "astro",
    "nextjs",
    "hugo",
    "wordpress",
    "vois-studio"
  ],
  "private": true
}
